# --- Postgres (Supabase) ---
# app_user / auth_service NO existen todavía en un proyecto Supabase nuevo:
# los crea `pnpm db:bootstrap-roles` (una vez, contra DATABASE_URL de abajo).
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=change_me_app
POSTGRES_AUTH_SERVICE_USER=auth_service
POSTGRES_AUTH_SERVICE_PASSWORD=change_me_auth_service

# Las tres URLs de abajo deben usar la conexión DIRECTA de Supabase
# (Project Settings > Database > Connection string > "Direct connection",
# host db.<project-ref>.supabase.co, puerto 5432) — NUNCA el pooler
# Supavisor en modo "Transaction" (puerto 6543 por defecto). RlsContextMiddleware
# reserva una conexión física y fija app.current_user_id con set_config a
# nivel de sesión para toda la duración de la request; el pooler en modo
# transacción reasigna la conexión física entre statements y ese valor se
# perdería. Si necesitas pooling contra Supabase, usa Supavisor en modo
# "Session" (mismo puerto 5432 en el connection string del pooler).

# URL usada por drizzle-kit y los scripts de administración (migrate,
# apply-rls, bootstrap-roles) - rol admin "postgres" de Supabase, bypassa RLS
DATABASE_URL=postgresql://postgres:change_me_admin@db.change_me_project_ref.supabase.co:5432/postgres

# URL usada por la API en runtime para casi todo - rol app_user, sujeto a RLS
DATABASE_APP_URL=postgresql://app_user:change_me_app@db.change_me_project_ref.supabase.co:5432/postgres

# URL usada SOLO por AuthService (login/refresh) - privilegios de columna
# mínimos vía políticas RLS dedicadas, ver packages/db/src/rls/policies.sql
DATABASE_AUTH_URL=postgresql://auth_service:change_me_auth_service@db.change_me_project_ref.supabase.co:5432/postgres

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
# URL pública por la que se llega a esta API — se usa para construir el
# redirect_uri de OAuth de Google. En Render: https://api.oponow.com
PUBLIC_API_URL=http://localhost:3000

# --- Integración con Google Calendar (apps/api/src/agenda/google) ---
# Google Cloud Console > APIs & Services > Credentials (tipo "Web application").
# Authorized redirect URI debe ser exactamente ${PUBLIC_API_URL}/agenda/google/callback
GOOGLE_CLIENT_ID=change_me_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change_me_google_client_secret
# 32 bytes en base64, p.ej.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=change_me_32_byte_base64_key
