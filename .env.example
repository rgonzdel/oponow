# --- Postgres (local Docker) ---
POSTGRES_DB=oponow
POSTGRES_USER=oponow_admin
POSTGRES_PASSWORD=change_me_admin
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=change_me_app
POSTGRES_AUTH_SERVICE_USER=auth_service
POSTGRES_AUTH_SERVICE_PASSWORD=change_me_auth_service

# URL usada por drizzle-kit (migraciones) - rol admin, bypassa RLS
DATABASE_URL=postgresql://oponow_admin:change_me_admin@localhost:5432/oponow

# URL usada por la API en runtime para casi todo - rol app_user, sujeto a RLS
DATABASE_APP_URL=postgresql://app_user:change_me_app@localhost:5432/oponow

# URL usada SOLO por AuthService (login/refresh) - bypassa RLS pero con
# privilegios de columna mínimos, ver docker/init/01-roles.sh
DATABASE_AUTH_URL=postgresql://auth_service:change_me_auth_service@localhost:5432/oponow

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- API ---
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
